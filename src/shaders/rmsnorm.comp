#version 450

// ============================================================================
// AMEVA Runtime - In-Place RMSNorm Compute Shader
// Hardware Target: ARM Mali & Qualcomm Adreno
// Math: x_i = (x_i / sqrt(mean(x^2) + eps)) * gamma_i
// Binding 0: GammaBuffer (resident model weights)
// Binding 2: DataBuffer (output_buffer_ in-place)
// ============================================================================

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer GammaBuffer {
    float gamma[];
};

layout(std430, binding = 2) buffer DataBuffer {
    float x[];
};

layout(push_constant) uniform PushConstants {
    uint in_dim;
    uint out_dim;            // Used as n_dim
    float dequant_scale;     // Used as eps
    uint weight_offset_bytes;// Byte offset into GammaBuffer (div 4 for float index)
    uint output_offset_words;// Element offset into DataBuffer
} params;

shared float shared_sum_sq[256];
shared float shared_inv_rms;

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint n_dim = params.out_dim;
    float eps = params.dequant_scale;
    uint gamma_offset = params.weight_offset_bytes / 4u;
    uint data_offset = params.output_offset_words;
    
    float thread_sum = 0.0;
    for (uint i = tid; i < n_dim; i += 256u) {
        float val = x[data_offset + i];
        thread_sum += val * val;
    }
    shared_sum_sq[tid] = thread_sum;
    barrier();
    
    // Parallel tree reduction (256 -> 1)
    if (tid < 128u) shared_sum_sq[tid] += shared_sum_sq[tid + 128u];
    barrier();
    if (tid < 64u)  shared_sum_sq[tid] += shared_sum_sq[tid + 64u];
    barrier();
    if (tid < 32u)  shared_sum_sq[tid] += shared_sum_sq[tid + 32u];
    barrier();
    if (tid < 16u)  shared_sum_sq[tid] += shared_sum_sq[tid + 16u];
    barrier();
    if (tid < 8u)   shared_sum_sq[tid] += shared_sum_sq[tid + 8u];
    barrier();
    if (tid < 4u)   shared_sum_sq[tid] += shared_sum_sq[tid + 4u];
    barrier();
    if (tid < 2u)   shared_sum_sq[tid] += shared_sum_sq[tid + 2u];
    barrier();
    if (tid == 0u) {
        float total_sum = shared_sum_sq[0] + shared_sum_sq[1];
        float mean_sq = total_sum / float(n_dim);
        shared_inv_rms = inversesqrt(mean_sq + eps);
    }
    barrier();
    
    float inv_rms = shared_inv_rms;
    for (uint i = tid; i < n_dim; i += 256u) {
        float g = (params.weight_offset_bytes != 0xFFFFFFFFu) ? gamma[gamma_offset + i] : 1.0;
        x[data_offset + i] = x[data_offset + i] * inv_rms * g;
    }
}
